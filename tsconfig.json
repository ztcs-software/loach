{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // `noUncheckedIndexedAccess` and `exactOptionalPropertyTypes` are
    // intentionally NOT on. Both would surface real but mostly-cosmetic
    // bugs across ~50 sites (every `array[i]` becomes `T | undefined`,
    // every optional-vs-undefined distinction tightens). Tracked as a
    // v1.1 follow-up — flipping them on requires touching enough call
    // sites that doing it pre-RTM is more risk than win.
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `tests/` (repo-level invariants) and the in-src *.test.ts files are part
  // of the project on purpose: `tsc --noEmit` emits nothing and vite bundles
  // only what index.html imports, so including tests here costs nothing at
  // build time but gives them type-checking (vitest transpiles via esbuild
  // WITHOUT checking types) and gives the editor the `@/*` path mapping
  // inside test files.
  "include": ["src", "tests"]
}
